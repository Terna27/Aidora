# Aidora Standalone Web Application Environment Configuration

# Base URL for the Go backend API.
# If unset or unreachable in production, production authentication returns SERVICE_UNAVAILABLE.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Enable/disable development mock authentication adapter.
# Set to 'false' in production or staging environments to strictly require backend auth endpoints.
VITE_ENABLE_MOCK_AUTH=true

# Enable/disable live mock polling simulation
VITE_ENABLE_MOCK_POLLING=true

# Mapbox / tile server token (optional - default SVG radar grid used when absent)
VITE_MAP_TILE_URL=
